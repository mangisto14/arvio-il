# Regular hosted ARVIO Web for Railway (not the Unraid self-host image).
# Railway service settings: Root Directory = /web, config file = /web/railway.json.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS builder
# Railway passes service variables to the build only when declared as ARGs.
# NEXT_PUBLIC_* values (and the IDs next.config.mjs maps to them) are inlined
# into the browser bundle at build time, so changing them requires a redeploy.
ARG NEXT_PUBLIC_SELF_HOSTED=false
ARG NEXT_PUBLIC_TELEGRAM_ENABLED
ARG NEXT_PUBLIC_PAYWALL_ENABLED=false
ARG NEXT_PUBLIC_ALLOW_NETLIFY_MEDIA_PROXY=false
ARG NEXT_PUBLIC_NETLIFY_BACKEND_URL
ARG NEXT_PUBLIC_ARVIO_APP_ANON_KEY
ARG APP_ANON_KEY
ARG NEXT_PUBLIC_ARVIO_RESOLVER_URL
ARG NEXT_PUBLIC_KOFI_URL
ARG NEXT_PUBLIC_MDBLIST_CLIENT_ID
ARG NEXT_PUBLIC_SPORTS_METADATA_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_TELEGRAM_API_ID
ARG NEXT_PUBLIC_TELEGRAM_API_HASH
ARG NEXT_PUBLIC_TRAKT_CLIENT_ID
ARG TRAKT_CLIENT_ID
ARG NEXT_PUBLIC_SIMKL_CLIENT_ID
ARG SIMKL_CLIENT_ID
ARG NEXT_PUBLIC_SIMKL_V2_CLIENT_ID
ARG SIMKL_V2_CLIENT_ID
# Only /web is in the build context, so use the checked-in translations
# instead of regenerating them from the Android resources in ../app.
ENV ARVIO_TRANSLATION_MODE=prebuilt \
    ARVIO_STANDALONE=true
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
